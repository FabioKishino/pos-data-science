stadia_key <- Sys.getenv("GGMAP_STADIAMAPS_API_KEY")
if (!nzchar(stadia_key)) stadia_key <- Sys.getenv("STADIA_MAPS_API_KEY")
google_key <- Sys.getenv("GGMAP_GOOGLE_API_KEY")
if (!nzchar(google_key)) google_key <- Sys.getenv("GOOGLE_MAPS_API_KEY")
if (nzchar(stadia_key)) {
register_stadiamaps(key = stadia_key, write = FALSE)
}
if (nzchar(google_key)) {
register_google(key = google_key, write = FALSE)
}
curitiba_map <- tryCatch({
if (nzchar(stadia_key)) {
get_stadiamap(curitiba_bbox, zoom = 11, maptype = "stamen_toner_lite")
} else if (nzchar(google_key)) {
get_map(location = c(lon = -49.27, lat = -25.43), zoom = 11,
source = "google", maptype = "roadmap")
} else {
NULL
}
}, error = function(e) NULL)
base_map <- function() {
if (is.null(curitiba_map)) {
message("Mapa-base nao carregado. Configure GGMAP_STADIAMAPS_API_KEY ou GGMAP_GOOGLE_API_KEY para usar tiles no ggmap.")
ggplot() + coord_fixed() + theme_minimal()
} else {
ggmap(curitiba_map, extent = "device")
}
}
