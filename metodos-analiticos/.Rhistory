library(igraph)
library(ggplot2)
library(ggmap)
# Carregamento: o arquivo .R e um RData compactado em gzip.
load("all_bus_info.R")
km_dist <- function(lat1, lon1, lat2, lon2) {
r <- 6371
to_rad <- pi / 180
dlat <- (lat2 - lat1) * to_rad
dlon <- (lon2 - lon1) * to_rad
a <- sin(dlat / 2)^2 + cos(lat1 * to_rad) * cos(lat2 * to_rad) * sin(dlon / 2)^2
2 * r * atan2(sqrt(a), sqrt(1 - a))
}
rows <- list()
k <- 1
for (i in seq_along(all_bus_info)) {
linha <- all_bus_info[[i]][[1]]
nome_linha <- all_bus_info[[i]][[2]]
tipo_linha <- all_bus_info[[i]][[3]]
rotas <- all_bus_info[[i]][[4]]
if (length(rotas) == 0) next
for (j in seq_along(rotas)) {
sentido <- rotas[[j]][[1]]
df <- rotas[[j]][[2]]
if (is.null(df) || nrow(df) == 0) next
df <- df[order(df$SEQ), ]
df$linha <- linha
df$nome_linha <- nome_linha
df$tipo_linha <- tipo_linha
df$sentido_rota <- sentido
df$route_id <- paste(linha, j, sentido, sep = "_")
rows[[k]] <- df
k <- k + 1
}
}
stops_long <- do.call(rbind, rows)
stops_long <- stops_long[!is.na(stops_long$NUM) &
!is.na(stops_long$LAT) &
!is.na(stops_long$LON), ]
stops_long$NUM <- as.character(stops_long$NUM)
vertices <- aggregate(cbind(LAT, LON) ~ NUM, stops_long, mean)
vertices$label <- unname(tapply(stops_long$NOME, stops_long$NUM, function(x) {
names(sort(table(x), decreasing = TRUE))[1]
})[vertices$NUM])
vertices$line_count <- as.integer(tapply(stops_long$linha, stops_long$NUM, function(x) {
length(unique(x))
})[vertices$NUM])
curitiba_bbox <- c(
left = min(vertices$LON) - 0.02,
bottom = min(vertices$LAT) - 0.02,
right = max(vertices$LON) + 0.02,
top = max(vertices$LAT) + 0.02
)
curitiba_map <- tryCatch({
if ("get_stadiamap" %in% ls("package:ggmap")) {
get_stadiamap(curitiba_bbox, zoom = 11, maptype = "stamen_toner_lite")
} else {
get_map(location = curitiba_bbox, source = "stamen", maptype = "toner-lite")
}
}, error = function(e) NULL)
base_map <- function() {
if (is.null(curitiba_map)) {
ggplot() + coord_fixed() + theme_minimal()
} else {
ggmap(curitiba_map)
}
}
edge_rows <- list()
e <- 1
for (rid in unique(stops_long$route_id)) {
df <- stops_long[stops_long$route_id == rid, ]
df <- df[order(df$SEQ), ]
if (nrow(df) < 2) next
for (p in 1:(nrow(df) - 1)) {
edge_rows[[e]] <- data.frame(
from = df$NUM[p],
to = df$NUM[p + 1],
weight = km_dist(df$LAT[p], df$LON[p], df$LAT[p + 1], df$LON[p + 1]),
linha = df$linha[p],
nome_linha = df$nome_linha[p],
tipo_linha = df$tipo_linha[p],
route_id = rid,
stringsAsFactors = FALSE
)
e <- e + 1
}
}
edges <- do.call(rbind, edge_rows)
edges <- edges[edges$from != edges$to & edges$weight > 0, ]
g <- graph_from_data_frame(edges, vertices = vertices, directed = FALSE)
g <- simplify(
g,
remove.multiple = TRUE,
remove.loops = TRUE,
edge.attr.comb = list(
weight = "min",
linha = function(x) paste(unique(x), collapse = ","),
nome_linha = function(x) paste(unique(x), collapse = " | "),
tipo_linha = function(x) paste(unique(x), collapse = ","),
route_id = function(x) paste(unique(x), collapse = ",")
)
)
# 1. Ponto mais carregado: maior numero de linhas distintas no ponto.
q1 <- data.frame(
NUM = V(g)$name,
ponto = V(g)$label,
linhas = V(g)$line_count
)
q1 <- q1[order(-q1$linhas), ]
head(q1, 10)
# 2. Media de linhas servidas por ponto.
q2 <- mean(V(g)$line_count)
q2
# 3. Distancia media dos caminhos existentes, em KM.
q3 <- mean_distance(g, directed = FALSE, weights = E(g)$weight, unconnected = TRUE)
q3
# 3. Distancia media dos caminhos existentes, em KM.
q3 <- mean_distance(g, directed = FALSE, weights = E(g)$weight, unconnected = TRUE)
q3
library(igraph)
library(ggplot2)
library(ggmap)
# Carregamento: o arquivo .R e um RData compactado em gzip.
load("all_bus_info.R")
km_dist <- function(lat1, lon1, lat2, lon2) {
r <- 6371
to_rad <- pi / 180
dlat <- (lat2 - lat1) * to_rad
dlon <- (lon2 - lon1) * to_rad
a <- sin(dlat / 2)^2 + cos(lat1 * to_rad) * cos(lat2 * to_rad) * sin(dlon / 2)^2
2 * r * atan2(sqrt(a), sqrt(1 - a))
}
rows <- list()
k <- 1
for (i in seq_along(all_bus_info)) {
linha <- all_bus_info[[i]][[1]]
nome_linha <- all_bus_info[[i]][[2]]
tipo_linha <- all_bus_info[[i]][[3]]
rotas <- all_bus_info[[i]][[4]]
if (length(rotas) == 0) next
for (j in seq_along(rotas)) {
sentido <- rotas[[j]][[1]]
df <- rotas[[j]][[2]]
if (is.null(df) || nrow(df) == 0) next
df <- df[order(df$SEQ), ]
df$linha <- linha
df$nome_linha <- nome_linha
df$tipo_linha <- tipo_linha
df$sentido_rota <- sentido
df$route_id <- paste(linha, j, sentido, sep = "_")
rows[[k]] <- df
k <- k + 1
}
}
stops_long <- do.call(rbind, rows)
stops_long <- stops_long[!is.na(stops_long$NUM) &
!is.na(stops_long$LAT) &
!is.na(stops_long$LON), ]
stops_long$NUM <- as.character(stops_long$NUM)
vertices <- aggregate(cbind(LAT, LON) ~ NUM, stops_long, mean)
vertices$label <- unname(tapply(stops_long$NOME, stops_long$NUM, function(x) {
names(sort(table(x), decreasing = TRUE))[1]
})[vertices$NUM])
vertices$line_count <- as.integer(tapply(stops_long$linha, stops_long$NUM, function(x) {
length(unique(x))
})[vertices$NUM])
curitiba_bbox <- c(
left = min(vertices$LON) - 0.02,
bottom = min(vertices$LAT) - 0.02,
right = max(vertices$LON) + 0.02,
top = max(vertices$LAT) + 0.02
)
curitiba_map <- tryCatch({
if ("get_stadiamap" %in% ls("package:ggmap")) {
get_stadiamap(curitiba_bbox, zoom = 11, maptype = "stamen_toner_lite")
} else {
get_map(location = curitiba_bbox, source = "stamen", maptype = "toner-lite")
}
}, error = function(e) NULL)
base_map <- function() {
if (is.null(curitiba_map)) {
ggplot() + coord_fixed() + theme_minimal()
} else {
ggmap(curitiba_map)
}
}
edge_rows <- list()
e <- 1
for (rid in unique(stops_long$route_id)) {
df <- stops_long[stops_long$route_id == rid, ]
df <- df[order(df$SEQ), ]
if (nrow(df) < 2) next
for (p in 1:(nrow(df) - 1)) {
edge_rows[[e]] <- data.frame(
from = df$NUM[p],
to = df$NUM[p + 1],
weight = km_dist(df$LAT[p], df$LON[p], df$LAT[p + 1], df$LON[p + 1]),
linha = df$linha[p],
nome_linha = df$nome_linha[p],
tipo_linha = df$tipo_linha[p],
route_id = rid,
stringsAsFactors = FALSE
)
e <- e + 1
}
}
edges <- do.call(rbind, edge_rows)
edges <- edges[edges$from != edges$to & edges$weight > 0, ]
g <- graph_from_data_frame(edges, vertices = vertices, directed = FALSE)
g <- simplify(
g,
remove.multiple = TRUE,
remove.loops = TRUE,
edge.attr.comb = list(
weight = "min",
linha = function(x) paste(unique(x), collapse = ","),
nome_linha = function(x) paste(unique(x), collapse = " | "),
tipo_linha = function(x) paste(unique(x), collapse = ","),
route_id = function(x) paste(unique(x), collapse = ",")
)
)
# 1. Ponto mais carregado: maior numero de linhas distintas no ponto.
q1 <- data.frame(
NUM = V(g)$name,
ponto = V(g)$label,
linhas = V(g)$line_count
)
q1 <- q1[order(-q1$linhas), ]
head(q1, 10)
# 2. Media de linhas servidas por ponto.
q2 <- mean(V(g)$line_count)
q2
# 3. Distancia media dos caminhos existentes, em KM.
q3 <- mean_distance(g, directed = FALSE, weights = E(g)$weight, unconnected = TRUE)
q3
# 4. Maior caminho existente, em KM: diametro ponderado.
diametro_km <- diameter(g, directed = FALSE, weights = E(g)$weight, unconnected = TRUE)
diametro_path <- get_diameter(g, directed = FALSE, weights = E(g)$weight,
unconnected = TRUE)
q4 <- data.frame(
ordem = seq_along(diametro_path),
NUM = V(g)$name[diametro_path],
ponto = V(g)$label[diametro_path],
LAT = V(g)$LAT[diametro_path],
LON = V(g)$LON[diametro_path]
)
diametro_km
q4
base_map() +
geom_point(data = vertices, aes(x = LON, y = LAT), size = 0.25, color = "grey75") +
geom_path(data = q4, aes(x = LON, y = LAT), color = "red", linewidth = 1) +
geom_point(data = q4[c(1, nrow(q4)), ], aes(x = LON, y = LAT), color = "black", size = 2) +
labs(title = "Diametro ponderado da rede de onibus de Curitiba")
# 5. Media de pontos/trechos nos caminhos existentes.
q5 <- mean_distance(g, directed = FALSE, weights = NA, unconnected = TRUE)
q5
# 6. Top 10 por betweenness: pontos mais intermediarios em caminhos curtos.
btw <- betweenness(g, directed = FALSE, weights = E(g)$weight, normalized = TRUE)
q6 <- data.frame(NUM = V(g)$name, ponto = V(g)$label, betweenness = btw)
q6 <- q6[order(-q6$betweenness), ]
head(q6, 10)
# 7. Top 10 por closeness: proximidade media ponderada no sistema.
cls <- closeness(g, weights = E(g)$weight, normalized = TRUE)
q7 <- data.frame(NUM = V(g)$name, ponto = V(g)$label, closeness = cls)
q7 <- q7[order(-q7$closeness), ]
head(q7, 10)
# 8. Classificacao da rede.
metricas_q8 <- c(
grau_medio = mean(degree(g)),
caminho_medio = mean_distance(g, directed = FALSE, weights = NA, unconnected = TRUE),
clustering = transitivity(g, type = "global"),
assortatividade_grau = assortativity_degree(g, directed = FALSE)
)
metricas_q8
plot(degree_distribution(g), type = "b",
xlab = "Grau", ylab = "P(k)",
main = "Distribuicao de grau")
# 9. P-Space: dois pontos se conectam quando compartilham ao menos uma linha.
line_stop <- unique(stops_long[, c("linha", "NUM")])
pairs <- do.call(rbind, by(line_stop, line_stop$linha, function(d) {
if (nrow(d) < 2) return(NULL)
cmb <- t(combn(d$NUM, 2))
data.frame(from = cmb[, 1], to = cmb[, 2], stringsAsFactors = FALSE)
}))
gp <- graph_from_data_frame(pairs, vertices = vertices, directed = FALSE)
gp <- simplify(gp, remove.multiple = TRUE, remove.loops = TRUE)
q9_onibus <- mean_distance(gp, directed = FALSE, weights = NA, unconnected = TRUE)
q9_trocas <- q9_onibus - 1
c(onibus = q9_onibus, trocas = q9_trocas)
dt_p <- distance_table(gp, directed = FALSE)
q9_dist <- data.frame(
onibus = seq_along(dt_p$res),
pares = as.numeric(dt_p$res)
)
q9_dist$trocas <- q9_dist$onibus - 1
ggplot(q9_dist, aes(x = trocas, y = pares)) +
geom_col(fill = "steelblue") +
scale_y_log10() +
labs(
title = "Distribuicao de trocas no P-Space",
x = "Numero de trocas",
y = "Quantidade de pares de pontos (escala log10)"
) +
theme_minimal()
# 10. Mapa apenas com linhas EXPRESSO.
plot_tipo <- function(tipo) {
df <- stops_long[stops_long$tipo_linha == tipo, ]
base_map() +
geom_path(data = df, aes(x = LON, y = LAT, group = route_id, color = nome_linha),
linewidth = 0.8, alpha = 0.85) +
geom_point(data = df, aes(x = LON, y = LAT, color = nome_linha),
size = 0.35, alpha = 0.6) +
labs(title = paste("Linhas", tipo, "em Curitiba")) +
theme(legend.position = "none")
}
plot_tipo("EXPRESSO")
# 11. Mapa apenas com linhas ALIMENTADOR.
plot_tipo("ALIMENTADOR")
# No RStudio, defina uma destas variaveis antes de rodar o script:
Sys.setenv(STADIA_MAPS_API_KEY = "bce19d4d-df1f-47d5-9b96-33c0a5c0f58b")
stadia_key <- Sys.getenv("STADIA_MAPS_API_KEY")
# 10. Mapa apenas com linhas EXPRESSO.
plot_tipo <- function(tipo) {
df <- stops_long[stops_long$tipo_linha == tipo, ]
base_map() +
geom_path(data = df, aes(x = LON, y = LAT, group = route_id, color = nome_linha),
linewidth = 0.8, alpha = 0.85) +
geom_point(data = df, aes(x = LON, y = LAT, color = nome_linha),
size = 0.35, alpha = 0.6) +
labs(title = paste("Linhas", tipo, "em Curitiba")) +
theme(legend.position = "none")
}
plot_tipo("EXPRESSO")
